# Copy to frontend/.env.local for local overrides. Never put secrets here:
# every VITE_* value is compiled into the public JavaScript bundle.

# Base path or URL of the SAMS REST API. Default: /api/v1 (same origin).
VITE_API_BASE_URL=/api/v1

# Minutes of inactivity before automatic sign-out (SAMS-F-004). Default: 15.
# VITE_IDLE_TIMEOUT_MINUTES=15

# Where the Vite dev server forwards /api requests (dev only, not bundled).
SAMS_API_PROXY=http://localhost:8080
